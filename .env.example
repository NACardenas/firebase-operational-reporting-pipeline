# Firebase Realtime Database URLs must usually end with .json
FIREBASE_URL_PRODUCTION=https://your-project-default-rtdb.firebaseio.com/production.json
FIREBASE_URL_INPUTS=https://your-project-default-rtdb.firebaseio.com/inputs.json

# Optional token for authenticated Firebase Realtime Database access
FIREBASE_AUTH_TOKEN=your_firebase_auth_token

REPORT_TYPE=daily
# daily, weekly, monthly

# Optional override for the date field used in queries
DATE_FIELD=fecharaw